# Copy to .env.local and fill in what you need. With nothing set, `npm run dev`
# uses in-memory storage (lost on restart) and scanning is switched off.

# Redis: one of these two in production.
# Redis over TCP (e.g. Redis Cloud from the Vercel Marketplace)
REDIS_URL=
# ...or Upstash Redis over REST (UPSTASH_REDIS_REST_URL / _TOKEN also work)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob, for QR images, receipt photos and slips.
# BLOB_STORE_ID uses Vercel's automatic OIDC token; or set a read-write token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Receipt scanning and slip reading (server only): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated Gemini models instead of the built-in chain
GEMINI_MODELS=

# Optional: absolute site URL for link previews on a custom domain
NEXT_PUBLIC_SITE_URL=

# Lets only Vercel Cron run the daily photo clean-up (without it, the clean-up
# runs at most every 6 hours for anyone who calls it)
CRON_SECRET=

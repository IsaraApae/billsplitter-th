{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)README.md' ':(exclude)docs' ':(exclude).github' ':(exclude)LICENSE' ':(exclude).env.example'",
  "crons": [{ "path": "/api/cron/cleanup-photos", "schedule": "0 20 * * *" }]
}

      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:8px;font:600 17px/1.45 -apple-system,BlinkMacSystemFont,'SF Pro Text','Noto Sans Thai',system-ui,sans-serif;cursor:pointer;transition: transform .2s cubic-bezier(.16,1,.3,1);background:none;border:0;color:var(--accent);}.ds-btn-ghost:hover{background:var(--hover);}.ds-btn-ghost:active{transform:scale(.95);}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"

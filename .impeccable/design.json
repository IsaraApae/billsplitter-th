  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action on a screen; dark text on the brand green.",
      "html": "<button class=\"ds-btn-primary\">Scan receipt</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:8px;font:600 17px/1.45 -apple-system,BlinkMacSystemFont,'SF Pro Text','Noto Sans Thai',system-ui,sans-serif;cursor:pointer;transition: transform .2s cubic-bezier(.16,1,.3,1);border:0;background:var(--accent-fill);color:var(--accent-ink);font-weight:700;box-shadow:0 8px 16px -10px rgb(0 135 90 / .8);}.ds-btn-primary:active{transform:scale(.95);}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}.ds-btn-primary:disabled{opacity:.4;pointer-events:none;}"
    },
    {

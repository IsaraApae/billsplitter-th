    {
      "name": "Navigation Bar",
      "kind": "nav",
      "refersTo": "nav-bar",
      "description": "A solid full-width bar with links and a separate green scan square.",
      "html": "<div class=\"ds-nav\"><a class=\"ds-nav-link ds-nav-on\" href=\"#\" aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span>Home</span></a><a class=\"ds-nav-link\" href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span>History</span></a><button class=\"ds-nav-scan\" aria-label=\"Scan receipt\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z\"/><circle cx=\"12\" cy=\"13\" r=\"3\"/></svg></button></div>",
      "css": ".ds-nav{display:flex;align-items:center;gap:10px;width:100%;padding:6px 12px;background:var(--raised);border-top:1px solid var(--raised-line);}.ds-nav-link{transition: transform .2s cubic-bezier(.16,1,.3,1);flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;height:52px;min-width:64px;border-radius:8px;color:var(--ink-2);font:600 11px system-ui,sans-serif;text-decoration:none;}.ds-nav-link:active,.ds-nav-scan:active{transform:scale(.95);}.ds-nav-link:focus-visible,.ds-nav-scan:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}.ds-nav-on{background:var(--accent-soft);color:var(--accent-strong);}.ds-nav-scan{transition: transform .2s cubic-bezier(.16,1,.3,1);display:grid;place-items:center;width:62px;height:62px;flex:none;border:0;border-radius:8px;background:var(--accent-fill);color:var(--accent-ink);box-shadow:var(--raised-shadow);cursor:pointer;}"
    },
    {
      "name": "Step Rank",
      "kind": "custom",
      "refersTo": "rank-square-current",
      "description": "The wizard's five steps as a rank of a chessboard; the pawn's green square travels along it.",
      "html": "<ol class=\"ds-rank\"><li class=\"ds-sq ds-sq-on\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"5.4\" r=\"3.9\"/><rect x=\"8.2\" y=\"9.4\" width=\"7.6\" height=\"1.7\" rx=\".85\"/><path d=\"M10.3 11.1c0 3.2-1 5.5-2.8 7.3h9c-1.8-1.8-2.8-4.1-2.8-7.3z\"/><rect x=\"5.3\" y=\"19\" width=\"13.4\" height=\"3.2\" rx=\"1.1\"/></svg><span>Items</span></li><li class=\"ds-sq ds-b\"><span>People</span></li><li class=\"ds-sq\"><span>Extras</span></li><li class=\"ds-sq ds-b\"><span>Review</span></li><li class=\"ds-sq\"><span>Share</span></li></ol>",
      "css": ".ds-rank{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none;border-radius:8px;overflow:hidden;box-shadow:var(--raised-shadow);}.ds-sq{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:60px;padding-bottom:7px;box-sizing:border-box;background:var(--square-a);color:var(--ink-2);font:600 12px system-ui,sans-serif;}.ds-b{background:var(--square-b);}.ds-sq-on{background:var(--accent-fill);color:var(--accent-ink);font-weight:700;}.ds-sq svg{position:absolute;top:7px;}"
    },
    {
      "name": "Scene Header",
